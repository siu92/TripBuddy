# Copy to .env.local for the local Spring profile. Fill values yourself.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tripbuddy
DB_USERNAME=
DB_PASSWORD=
# Use a unique random secret of at least 32 bytes; never commit the real value.
JWT_SECRET=
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_PROVIDER=simple

# External services
KAKAO_REST_API_KEY=
KMA_SHORT_SERVICE_KEY=
KMA_MID_SERVICE_KEY=
AERODATABOX_API_KEY=
LODGING_API_KEY=
TOURIST_LODGING_API_KEY=
OPINET_API_KEY=

# Configure AWS credentials through the standard SDK credential provider chain.
AWS_REGION=ap-northeast-2
AWS_BEDROCK_REGION=ap-northeast-2
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
TRIP_PLAN_QUEUE_URL=
# Run a separate process with APP_RUNTIME_ROLE=worker for async generation.
APP_RUNTIME_ROLE=api
